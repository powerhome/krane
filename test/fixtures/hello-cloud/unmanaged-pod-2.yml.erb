apiVersion: v1
kind: Pod
metadata:
  name: unmanaged-pod-2-<%= deployment_id %>
  annotations:
    krane.shopify.io/timeout-override: "60s"
  labels:
    type: unmanaged-pod
    name: unmanaged-pod-2-<%= deployment_id %>
    app: hello-cloud
spec:
  activeDeadlineSeconds: 60
  restartPolicy: Never
  containers:
    - name: hello-cloud
      image: busybox:1.36.0-glibc
      imagePullPolicy: IfNotPresent
      command: ["sh", "-c", "echo 'Hello from the second command runner!' && test 1 -eq 1"]
      env:
      - name: CONFIG
        valueFrom:
          configMapKeyRef:
            name: hello-cloud-configmap-data
            key: datapoint2
